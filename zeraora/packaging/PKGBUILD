# Maintainer: C-Fuego
pkgname=zeraora
pkgver=0.3.0
pkgrel=1
pkgdesc="Print pokemon sprites in your terminal"
arch=('x86_64' 'aarch64')
url="https://codeberg.org/C-Fuego/Rezig"
license=('GPL-3.0-only')
makedepends=('zig-master-bin')
# 从本目录上一级的源码树打包：zeraora 已经是 Rezig 仓库里的一个子目录，
# 不再单独克隆 git。
source=()
sha256sums=()

build() {
  rm -rf "$srcdir/tree"
  mkdir -p "$srcdir/tree/zeraora"
  cp -a "$startdir/../assets" "$startdir/../src" "$startdir/../build.zig" \
        "$startdir/../build.zig.zon" "$startdir/../embed.zig" "$startdir/../LICENSE" \
        "$startdir/../README.md" "$srcdir/tree/zeraora/"
  cd "$srcdir/tree/zeraora"
  zig build -Doptimize=ReleaseFast --summary all
}

check() {
  cd "$srcdir/tree/zeraora"
  zig build test -Doptimize=ReleaseFast
}

package() {
  cd "$srcdir/tree/zeraora"
  DESTDIR="$pkgdir" zig build -Doptimize=ReleaseFast --prefix /usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
