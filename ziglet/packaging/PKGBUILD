pkgname=ziglet
pkgver=1.0.0
pkgrel=1
pkgdesc="FIGlet-compatible text renderer with TOIlet filters and exports"
arch=('x86_64')
url=""
license=('MIT')
depends=('zlib')
makedepends=('zig-master-bin')
source=()
sha256sums=()

build() {
  # textfig 现在就在 ziglet/src/textfig 里，整棵树拷过去即可
  rm -rf "$srcdir/tree"
  mkdir -p "$srcdir/tree/Rezig/ziglet"
  cp -a "$startdir/../src" "$srcdir/tree/Rezig/ziglet/src"
  cd "$srcdir/tree/Rezig/ziglet/src"
  ZIG_GLOBAL_CACHE_DIR="$srcdir/.zig-global" zig build -Doptimize=ReleaseFast \
    --prefix "$srcdir/out" --cache-dir "$srcdir/.zig-cache"
}

package() {
  install -Dm755 "$srcdir/out/bin/ziglet" "$pkgdir/usr/bin/ziglet"
  install -Dm755 "$srcdir/out/bin/zfiglist" "$pkgdir/usr/bin/zfiglist"
  install -Dm755 "$srcdir/out/bin/zshowfigfonts" "$pkgdir/usr/bin/zshowfigfonts"
  install -Dm755 "$srcdir/out/bin/zchkfont" "$pkgdir/usr/bin/zchkfont"
  install -Dm644 "$srcdir/tree/Rezig/ziglet/src/README.md" "$pkgdir/usr/share/doc/ziglet/README.md"
  # 随包带一份 FIGlet/TOIlet 字体，系统没装 figlet/toilet 也能直接用
  install -d "$pkgdir/usr/share/ziglet/fonts"
  find "$srcdir/tree/Rezig/ziglet/src/textfig/fonts" -maxdepth 1 -type f \
    \( -name '*.flf' -o -name '*.flc' -o -name '*.tlf' \) \
    -exec cp {} "$pkgdir/usr/share/ziglet/fonts/" \;
}
