pkgname=ztoilet
pkgver=1.0.0
pkgrel=1
pkgdesc="TOIlet clone written in Zig"
arch=('x86_64')
url=""
license=('MIT')
depends=('zlib')
makedepends=('zig')
source=()
sha256sums=()

build() {
  # 还原 Rezig/{zfiglet|ztoilet,textfig}/src 的相对布局，路径依赖 ../../textfig/src 才能成立
  mkdir -p "$srcdir/tree/Rezig/ztoilet/src" "$srcdir/tree/Rezig/textfig/src"
  cp -a "$startdir/../src/." "$srcdir/tree/Rezig/ztoilet/src/"
  cp -a "$startdir/../../textfig/src/." "$srcdir/tree/Rezig/textfig/src/"
  cd "$srcdir/tree/Rezig/ztoilet/src"
  ZIG_GLOBAL_CACHE_DIR="$srcdir/.zig-global" zig build -Doptimize=ReleaseFast \
    --prefix "$srcdir/out" --cache-dir "$srcdir/.zig-cache"
}

package() {
  install -Dm755 "$srcdir/out/bin/ztoilet" "$pkgdir/usr/bin/ztoilet"
  install -Dm644 "$srcdir/tree/Rezig/ztoilet/src/README.md" "$pkgdir/usr/share/doc/ztoilet/README.md"
  # 随包带一份 FIGlet 字体，系统没装 figlet 也能直接用
  install -d "$pkgdir/usr/share/ztoilet/fonts"
  cp "$srcdir/tree/Rezig/textfig/src/fonts/"*.flf "$srcdir/tree/Rezig/textfig/src/fonts/"*.flc \
     "$pkgdir/usr/share/ztoilet/fonts/"
}
